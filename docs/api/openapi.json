        ]
      }
    },
    "/health/deep": {
      "get": {
        "description": "Expose runtime configuration and subsystem state for operators.\n\nSecrets are never included -- only whether they are configured.",
        "operationId": "deep_health_deep_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Deep Health Deep Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "summary": "Deep diagnostic",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Return 200 whenever the process is running and the event loop is responsive.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Check every backing dependency.\n\nIn M1 the datastores are not yet wired, so they report ``skipped`` rather\nthan faking success. M2 replaces these with real connection checks.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
