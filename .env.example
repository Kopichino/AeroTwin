# AeroTwin configuration. Copy to .env and adjust.
# Every variable is prefixed AT_ and maps to a field on at_config.Settings.

# ── identity ──────────────────────────────────────────────────────────────────
AT_PROFILE=local                 # local | docker | ci | demo
AT_SERVICE_NAME=api
AT_DEBUG=false
AT_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
AT_LOG_JSON=true                 # false gives colourised console output

# ── datastores ────────────────────────────────────────────────────────────────
AT_POSTGRES_DSN=postgresql+asyncpg://aerotwin:aerotwin@localhost:5432/aerotwin
AT_REDIS_DSN=redis://localhost:6379/0
AT_CHROMA_HOST=localhost
AT_CHROMA_PORT=8003

# ── http ──────────────────────────────────────────────────────────────────────
AT_API_PORT=8000
AT_INFERENCE_URL=http://localhost:8001

# ── security (CHANGE BEFORE ANY DEPLOYMENT) ──────────────────────────────────
AT_JWT_SECRET=dev-only-secret-change-me

# ── replay / twin ─────────────────────────────────────────────────────────────
AT_REPLAY_SPEED=1                # one of 0.5 1 2 4 8 16 32
AT_SHARD_INDEX=0
AT_SHARD_COUNT=1

# ── agents ────────────────────────────────────────────────────────────────────
# 'none' runs every agent through its deterministic fallback, so the platform is
# fully demonstrable with no API key and no internet (NFR-10 / ADR-015).
AT_LLM_PROVIDER=none             # openai | groq | ollama | none
AT_LLM_MODEL=gpt-4o-mini
# AT_LLM_API_KEY=

# ── observability ─────────────────────────────────────────────────────────────
AT_OTEL_ENABLED=false
AT_OTEL_ENDPOINT=http://localhost:4317
