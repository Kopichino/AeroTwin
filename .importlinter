; Architectural boundary enforcement (Doc 01 section 1.4, Doc 03 section 3.13).
; These contracts are the executable form of the layering diagram. A violation
; fails CI, which is what stops the architecture eroding under delivery pressure.

[importlinter]
root_packages =
    at_core
    at_config
    at_observability
    at_data
    at_persistence
    at_bus
    at_api
    at_twin
include_external_packages = True

[importlinter:contract:domain-purity]
name = Domain kernel is pure (no I/O, no frameworks, no service imports)
type = forbidden
source_modules =
    at_core.domain
    at_core.events
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    redis
    httpx
    requests
    pydantic
    pydantic_settings
    structlog
    torch
    numpy
    pandas
    at_api
    at_config
    at_observability
; Rationale: at_core.domain must stay a pure, deterministic, dependency-free
; kernel so the entire twin/health model is unit-testable with zero setup
; (Doc 03 section 3.6 invariant). Note this deliberately forbids pydantic too --
; wire schemas belong in at_contracts, not in the domain.

[importlinter:contract:api-layering]
name = API respects routers -> services -> repos -> infra
type = layers
layers =
    routers | ws
    services
    repos
    middleware
containers =
    at_api
exhaustive = False
; Rationale: prevents routers reaching straight into repositories, which is the
; single most common way a clean FastAPI codebase turns into spaghetti.

[importlinter:contract:config-independence]
name = Config library depends on nothing internal
type = forbidden
source_modules =
    at_config
forbidden_modules =
    at_core
    at_api
    at_observability

[importlinter:contract:observability-independence]
name = Observability library depends on nothing internal
type = forbidden
source_modules =
    at_observability
forbidden_modules =
    at_core
    at_api
    at_config

[importlinter:contract:domain-has-no-dataframes]
name = Domain kernel never depends on pandas, numpy or SQLAlchemy
type = forbidden
source_modules =
    at_core
forbidden_modules =
    pandas
    numpy
    sqlalchemy
    at_data
    at_persistence
; Rationale: at_core is imported by every service including the latency-critical
; twin engine. Pulling pandas into it would add ~100 MB and seconds of import time
; to processes that only need value objects.

[importlinter:contract:persistence-is-leaf]
name = Persistence depends only on the domain
type = forbidden
source_modules =
    at_persistence
forbidden_modules =
    at_api
    at_data
    fastapi

[importlinter:contract:data-library-is-offline]
name = Data preparation never imports web or persistence layers
type = forbidden
source_modules =
    at_data
forbidden_modules =
    fastapi
    at_api
    at_persistence
; Rationale: ingestion and EDA are offline batch concerns. Keeping them free of
; the serving stack means the training image never needs FastAPI installed.

[importlinter:contract:twin-engine-is-headless]
name = Twin engine never imports the web layer
type = forbidden
source_modules =
    at_twin
forbidden_modules =
    fastapi
    starlette
    at_api
; Rationale: the twin engine is a headless worker process. If it ever needs to
; expose HTTP it does so via the bus and the API service, never by importing them.

[importlinter:contract:bus-is-transport-only]
name = Bus library knows nothing about the domain it carries
type = forbidden
source_modules =
    at_bus
forbidden_modules =
    at_twin
    at_api
    at_persistence
    at_data
    fastapi
; Rationale: the bus moves opaque envelopes. Keeping it ignorant of twin types is
; what allows the Redis and in-memory adapters to be swapped freely, and what will
; let agent and simulation traffic reuse it unchanged.

[importlinter:contract:no-cycles]
name = No circular dependencies between top-level packages
type = independence
modules =
    at_config
    at_observability
